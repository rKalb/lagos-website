---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import EmailGatedDownload from '../components/EmailGatedDownload.astro';
---

<BaseLayout
  title="Pricing"
  description="Lagos is free forever — every local engine, unlimited dictation, no account, no word limits, no subscription."
>
  <!-- Hero -->
  <section class="pt-20 pb-14 px-4 sm:px-6 lg:px-8 text-center">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-5xl font-bold mb-5" style="color: var(--color-text); letter-spacing: -0.02em;">
        Free forever.
      </h1>
      <p class="text-lg" style="color: var(--color-text-muted);">
        Everything that turns speech into text — capture, transcription, paste, history, every local engine — is free forever. Not a trial. Not a word quota.
      </p>
    </div>
  </section>

  <!-- Free card -->
  <section class="pb-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-xl">
      <div
        class="rounded-2xl border p-8"
        style="background-color: var(--color-surface); border-color: var(--color-border); box-shadow: 0 1px 3px 0 rgba(0,0,0,0.07);"
      >
        <div class="mb-6">
          <h2 class="text-xl font-bold mb-1" style="color: var(--color-text);">Lagos</h2>
          <div class="flex items-end gap-1 my-4">
            <span class="text-5xl font-bold" style="color: var(--color-text); letter-spacing: -0.03em;">$0</span>
            <span class="text-sm pb-2" style="color: var(--color-text-muted);">forever</span>
          </div>
          <p class="text-sm" style="color: var(--color-text-muted);">No credit card. No account. No catch.</p>
        </div>

        <ul class="space-y-3 text-sm mb-8" style="color: var(--color-text-muted);">
          {[
            'Hold-to-talk dictation in every app, system-wide',
            'Double-tap lock mode for hands-free continuous dictation',
            'Instant capture — mic on only while recording (opt-in pre-roll mode)',
            'All three engines: Apple Speech, WhisperKit, and Parakeet (Beta)',
            '100% on-device — audio never leaves your Mac',
            'Unlimited transcription history with full-text search',
            'Auto-detect + 12 languages',
            'Media ducking, sound packs, customizable shortcut',
            'Signed, notarized, auto-updating',
          ].map(item => (
            <li class="flex items-start gap-2.5">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-0.5" aria-hidden="true">
                <path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent-600);"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <!-- Download -->
        <EmailGatedDownload size="md" />
      </div>
    </div>
  </section>

  <!-- The promise -->
  <section class="pb-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">
      <div
        class="rounded-xl p-6 text-center border"
        style="background: linear-gradient(135deg, rgba(245,158,11,0.06) 0%, rgba(245,158,11,0.02) 100%); border-color: var(--color-border);"
      >
        <h2 class="text-base font-bold mb-2" style="color: var(--color-text);">How will Lagos make money?</h2>
        <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
          Honestly: core dictation is free forever. Advanced AI writing features (smart modes, personal dictionary, context awareness) may become a <strong>one-time Pro purchase</strong> down the road — <strong>never a subscription, and never your audio</strong>. We're saying this now so there's no rug-pull later.
        </p>
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="pb-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-sm" style="color: var(--color-text-muted);">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="shrink-0" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Audio never leaves your Mac
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="shrink-0" aria-hidden="true">
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.75"/>
          </svg>
          No word limits, ever
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="shrink-0" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="currentColor" stroke-width="1.75"/>
            <path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
          Signed &amp; notarized by Apple
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 px-4 sm:px-6 lg:px-8" style="background-color: var(--color-surface);">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-3xl font-bold mb-10 text-center" style="color: var(--color-text); letter-spacing: -0.02em;">
        Frequently asked questions
      </h2>
      <div class="space-y-3">
        {[
          {
            q: 'Is Lagos really free forever?',
            a: 'Yes. Everything that turns speech into text — hold-to-talk, lock mode, all three local engines (Apple Speech, WhisperKit, Parakeet), history with search, sound packs — is free forever. Local engines run on your hardware; there is nothing to meter.',
          },
          {
            q: 'Then how do you pay for this?',
            a: 'Right now we don\'t — Lagos is a labor of love by a solo developer. If advanced AI writing features ship later (smart modes, personal dictionary, context awareness), they may become a one-time Pro purchase, like VoiceInk or MacWhisper. Never a subscription, never an account requirement for the free core, and never your audio.',
          },
          {
            q: 'Do I need an account?',
            a: 'No. There is no account, no sign-in, and no license key. Download the DMG, drag to Applications, grant two permissions, and start dictating. The email box on the download button is optional — it just subscribes you to release notes.',
          },
          {
            q: 'What are the word or usage limits?',
            a: 'There are none. Some competitors cap free dictation (for example, 2,000 words per week) because every word costs them server money. Lagos transcribes on your Mac, so your usage costs us nothing.',
          },
          {
            q: 'Does Lagos collect any data?',
            a: 'Lagos never collects your audio or transcriptions. It does send anonymous usage analytics (which features are used, crash reports) by default — disclosed during onboarding, with a kill switch in Settings → Privacy. See the Privacy Policy for the full picture.',
          },
          {
            q: 'What Macs does it run on?',
            a: 'macOS 14 Sonoma or later. Apple Silicon Macs get all three engines. Intel Macs run the Apple Speech engine (WhisperKit and Parakeet require Apple Silicon).',
          },
        ].map(item => (
          <details class="group rounded-xl border" style="border-color: var(--color-border); background-color: var(--color-bg);">
            <summary
              class="flex items-center justify-between px-6 py-4 cursor-pointer font-medium text-sm list-none"
              style="color: var(--color-text);"
            >
              {item.q}
              <svg
                class="transition-transform group-open:rotate-180 shrink-0 ml-4"
                width="16" height="16" viewBox="0 0 16 16"
                fill="currentColor"
                style="color: var(--color-text-muted);"
                aria-hidden="true"
              >
                <path d="M8 10.5L3 5.5h10L8 10.5z"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed" style="color: var(--color-text-muted);">
              {item.a}
            </div>
          </details>
        ))}
      </div>

      <!-- Newsletter -->
      <div class="mt-14 text-center">
        <h3 class="text-lg font-bold mb-2" style="color: var(--color-text);">Want to hear when new features ship?</h3>
        <p class="text-sm mb-6" style="color: var(--color-text-muted);">
          Release notes, engineering stories, and a heads-up if Pro ever becomes real.
        </p>
        <NewsletterForm type="newsletter" buttonText="Subscribe" />
      </div>
    </div>
  </section>
</BaseLayout>
