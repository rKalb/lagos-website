    <div class="mx-auto max-w-2xl text-center">
      <h2
        class="text-4xl sm:text-5xl font-bold mb-5 leading-tight"
        style="color: var(--color-warm-50); letter-spacing: -0.02em;"
      >
        Start talking,<br/>stop typing.
      </h2>
      <p class="text-lg mb-10" style="color: var(--color-warm-400);">
        Free forever. No account, no subscription, no catch.
      </p>
      <div class="flex justify-center">
        <EmailGatedDownload size="lg" theme="dark" />
      </div>
    </div>
  </section>

  <!-- ── Newsletter ── -->
  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-lg text-center">
      <h2 class="text-2xl font-bold mb-2" style="color: var(--color-text); letter-spacing: -0.02em;">
        Follow along
      </h2>
      <p class="text-sm mb-8" style="color: var(--color-text-muted);">
        Get release notes and the occasional behind-the-scenes engineering story by email. Prefer feeds? There's a
        <a href="https://github.com/rKalb/lagos-releases/releases.atom" style="color: var(--color-link);">release notes RSS feed</a> too.
      </p>
      <NewsletterForm type="newsletter" buttonText="Subscribe" />
      <p class="text-xs mt-8 leading-relaxed mx-auto max-w-md" style="color: var(--color-text-muted);">
        <strong style="color: var(--color-text);">Our promise:</strong> everything that turns speech into text — capture, transcription, paste, history, every local engine — is free forever. Advanced AI writing features may become a one-time Pro purchase someday — never a subscription, and never your audio.
      </p>
    </div>
  </section>

</BaseLayout>
